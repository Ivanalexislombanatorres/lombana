# Copiar a .env y completar. Nunca subir .env al repositorio.

# Conexión de la aplicación (web y worker). Usa el rol lombana_app,
# que NO puede saltarse Row Level Security.
DATABASE_URL=postgres://lombana_app:CAMBIAR_CLAVE_APP@localhost:5432/lombana

# Conexión para migraciones. Usa un rol dueño del esquema.
# Solo la usan scripts de migración y CI; nunca la aplicación en ejecución.
DATABASE_ADMIN_URL=postgres://postgres@localhost:5432/lombana

# Clave del rol lombana_app que crean las migraciones (solo desarrollo/CI).
# En producción la define el gestor de secretos, no este archivo.
LOMBANA_APP_DB_PASSWORD=CAMBIAR_CLAVE_APP

# Entorno: development | test | production
APP_ENV=development

# --- Pendientes de decisión (REQUIERE CREDENCIAL) ---
# Proveedor de IA inicial: sin definir.
# Proveedor de email transaccional: sin definir.
# Object storage: sin definir.
