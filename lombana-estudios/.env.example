# Copia este archivo como .env (en la carpeta lombana-estudios) para cambiar la configuración.

# Motor de base de datos: sqlite (local, un usuario) o postgresql
LOMBANA_DB_ENGINE=sqlite

# Solo si usas PostgreSQL: servidor SIN nombre de base (la fábrica crea lombana_factory y erp_* sola).
# El usuario necesita permiso CREATEDB.
# LOMBANA_PG_URL=postgresql+psycopg2://lombana:TU_CLAVE@localhost:5432

# Opcional: carpetas de datos y respaldos (por defecto ./data y ./backups)
# LOMBANA_DATA_DIR=C:\LombanaDatos\data
# LOMBANA_BACKUPS_DIR=D:\Respaldos\lombana

# Duración de la sesión en minutos
LOMBANA_TOKEN_MINUTES=480

# Puerto del servidor local
LOMBANA_PORT=8000
